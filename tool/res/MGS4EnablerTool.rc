#include <windows.h>
#include "version.hpp"

// wxWidgets' own resources: the common-controls manifest (with DPI awareness, see the
// project's wxUSE_DPI_AWARE_MANIFEST define) and the cursors it needs.
#include "wx/msw/wx.rc"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    MGS4E_FILE_VERSION_RC
 PRODUCTVERSION MGS4E_FILE_VERSION_RC
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      MGS4E_COMPANY_NAME "\0"
            VALUE "FileDescription",  MGS4E_DISPLAY_NAME " settings\0"
            VALUE "FileVersion",      MGS4E_VERSION_STRING "\0"
            VALUE "InternalName",     MGS4E_DISPLAY_NAME ".exe\0"
            VALUE "OriginalFilename", MGS4E_DISPLAY_NAME ".exe\0"
            VALUE "ProductName",      MGS4E_DISPLAY_NAME "\0"
            VALUE "ProductVersion",   MGS4E_VERSION_STRING "\0"
            VALUE "LegalCopyright",   MGS4E_COPYRIGHT "\0"
            VALUE "Comments",         MGS4E_REPO_URL "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDI_ICON1 ICON   "MGS4Enabler.ico"
banner    RCDATA "banner.png"
