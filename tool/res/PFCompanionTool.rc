#include <windows.h>
#include "version.hpp"

// wxWidgets' own resources: the common-controls manifest (with DPI awareness, see the
// project's wxUSE_DPI_AWARE_MANIFEST define) and the cursors it needs.
#include "wx/msw/wx.rc"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PFC_FILE_VERSION_RC
 PRODUCTVERSION PFC_FILE_VERSION_RC
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      PFC_COMPANY_NAME "\0"
            VALUE "FileDescription",  PFC_DISPLAY_NAME " settings\0"
            VALUE "FileVersion",      PFC_VERSION_STRING "\0"
            VALUE "InternalName",     PFC_DISPLAY_NAME ".exe\0"
            VALUE "OriginalFilename", PFC_DISPLAY_NAME ".exe\0"
            VALUE "ProductName",      PFC_DISPLAY_NAME "\0"
            VALUE "ProductVersion",   PFC_VERSION_STRING "\0"
            VALUE "LegalCopyright",   PFC_COPYRIGHT "\0"
            VALUE "Comments",         PFC_REPO_URL "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDI_ICON1 ICON   "PFCompanion.ico"
banner    RCDATA "banner.png"
