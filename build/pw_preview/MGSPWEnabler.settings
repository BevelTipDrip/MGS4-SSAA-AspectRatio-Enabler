; MGS Peace Walker SSAA and Aspect Ratio Enabler settings. Edit by hand or with the settings tool
; from the full release; unknown keys are kept. Read by MGSPWEnabler.asi when the game starts.
; This file goes in the game's install folder, next to the "mgspw" folder.

[Graphics]
; The shape of the picture. "16:9" is the game's own layout. Any other shape widens or heightens
; the PSP canvas to it: the world fills the display at correct proportions, the HUD and menus keep
; the 16:9 scale and stay centred, and the in-mission HUD groups sit at the display edges.
; "Use Display" takes the primary display's shape at start-up.
; One of: "Use Display", "16:9", "16:10", "21:9", "32:9", "4:3"
Aspect Ratio = "Use Display"

; The picture on screen (the window's client area, or the display mode in Fullscreen), one list
; per shape; only the list of the selected shape is used. With "Use Display" the display's size.
Screen Resolution (16:9) = "3840x2160"
Screen Resolution (16:10) = "1920x1200"
Screen Resolution (21:9) = "3440x1440"
Screen Resolution (32:9) = "5120x1440"
Screen Resolution (4:3) = "1600x1200"

; The scene is rendered at an integer multiple of the PSP canvas and the game's own final blit
; downscales it into the picture (the game's launcher offers 3x and 4x). 8x is 4K-class, 16x is
; 8K-class; 16x wants GPU Local Textures on. One list per shape, as above.
Render Resolution (16:9) = "3840x2176 (8x)"
Render Resolution (16:10) = "3840x2400 (8x)"
Render Resolution (21:9) = "5200x2176 (8x)"
Render Resolution (32:9) = "7736x2176 (8x)"
Render Resolution (4:3) = "3840x2880 (8x)"
; With "Use Display" the canvas is only known at start-up, so the render size is this multiple.
Render Scale = 8

; "Use Game Setting" keeps the mode saved by the in-game Options. "Fullscreen" is the game's
; exclusive mode (run at the display's current refresh rate), "Borderless" a frameless window the
; size of the display, "Windowed" a normal window with the screen resolution as its client area.
; The choice is written into the game's saved setting each launch; Options shows it.
Window Mode = "Use Game Setting"

; "4x" is the game's own; "Off" saves about 2 ms a frame at 8K.
MSAA = "4x"

; 16x anisotropic filtering on every texture the game samples linearly (the game uses none).
Anisotropic Filtering = true

; The game's full-size frame textures carry CPU write access and end up in system memory, so its
; per-frame copies into them cross the PCIe bus (about 5 ms each at 8K). On, they stay in video
; memory: 60 fps at 8K instead of 27. The game was never seen to write them from the CPU.
; Busy Wait Fix: the game spins where it should wait, which costs about a full core and is what
; the 60 Hz stutter was. 0 off; 1 the render thread waits on an event for the frame handoff instead
; of polling a flag with Sleep(0); 2 also sleeps the ticker's last sub-millisecond on a high
; resolution timer; 3 also parks the message pump on its queue. Cumulative, and ordered so that
; turning it down keeps the part that matters. Turn it down if another overlay misbehaves.
Busy Wait Fix = Everything

; NVIDIA Fast Sync (NVIDIA graphics cards only; does nothing on AMD or Intel). With G-SYNC or any
; variable refresh display on a 60 Hz mode and V-Sync on, the NVIDIA driver holds the game to 59
; frames a second. The game's clock cannot slow down from 60, so one frame a second is dropped: a
; regular hitch once a second. With Vertical sync = Fast the same driver paces at 60, G-SYNC left
; on. true sets that for this game only, in the driver's own per-game profile, when the game
; starts; false puts back what it replaced (recorded in MGSPWEnabler.nvidia.state) and never
; touches a Fast setting you made yourself in the NVIDIA Control Panel.
NVIDIA Fast Sync = false

; Mouse. The game already reads the mouse through Raw Input and turns the camera in proportion to
; your hand; these correct what is wrong on the way.
; Mouse Late Sample: the game reads the mouse, then waits out the frame, then turns the camera,
; so the camera always moves by what your hand did a frame ago. true reads the mouse again right
; before the camera uses it (nothing is counted twice): about 15 ms less latency.
Mouse Late Sample = true
; Mouse Prompt Pump: the game's mouse thread handles one message and then sleeps, every pass, so
; fast movement arrives in clumps and the turn speed wobbles, most of all with a high polling rate
; mouse. true handles each message as it arrives. Needs Busy Wait Fix = Everything.
Mouse Prompt Pump = true
; Mouse Fraction Carry: each frame the game cuts the turn down to a whole angle unit and throws the
; fraction away (up to 8% of a slow movement at low sensitivity). true keeps the fraction.
Mouse Fraction Carry = true
; Mouse Uniform Rail: in the normal third-person camera, looking up and down slides the camera
; along a rail of four presets, so the same hand movement tilts the view by very different amounts
; depending on where the camera is. true makes one count tilt the view as much as it turns it
; sideways, everywhere. Off by default: it changes the feel. Aiming is not affected.
Mouse Uniform Rail = false
; Mouse Vertical Sensitivity: how fast the mouse looks up and down, as a percentage of sideways
; (25 to 400; 100 = the same). Every camera, aiming included. Mouse only.
Mouse Vertical Sensitivity = 100

; State Object Cache: the game asks the device to create the same handful of blend, depth-stencil,
; rasterizer and sampler state objects hundreds of times a frame, and a whole session only ever
; uses 42 distinct ones. They are immutable, so the one it asked for last time is handed back.
State Object Cache = true

; Audio Prefetch (EXPERIMENTAL, off by default): the single-frame hitch when a voice line or
; Codec call starts is the game reading the line from a cold archive on its main thread.
; "Voice archives at start" reads those archives through in the background after launch (about
; 1.6 GB, given back to Windows whenever anything else needs the memory) so they are already in
; memory when asked for. Try it if you see that hitch. "As opened" is the weaker form.
Audio Prefetch = Off

GPU Local Textures = true

[Debugging]
; Writes more detail to logs\MGSPWEnabler_Game.log: which hooks were installed and what each
; setting resolved to. Turn it on before reproducing a problem.
Debug Logging = false
