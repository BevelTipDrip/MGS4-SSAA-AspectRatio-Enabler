; MGS Peace Walker SSAA and Aspect Ratio Enabler settings, LAB build. The keys are the normal
; build's plus the research keys (all under [Graphics]). Edit by hand; unknown keys are kept.
; This file goes in the game's install folder, next to the "mgspw" folder.

[Graphics]
; ---- the normal settings (see README of the normal build) ----
; One of: "Use Display", "16:9", "16:10", "21:9", "32:9", "4:3"
Aspect Ratio = "Use Display"
Screen Resolution (16:9) = "3840x2160"
Screen Resolution (16:10) = "1920x1200"
Screen Resolution (21:9) = "3440x1440"
Screen Resolution (32:9) = "5120x1440"
Screen Resolution (4:3) = "1600x1200"
Render Resolution (16:9) = "3840x2176 (8x)"
Render Resolution (16:10) = "3840x2400 (8x)"
Render Resolution (21:9) = "5200x2176 (8x)"
Render Resolution (32:9) = "7736x2176 (8x)"
Render Resolution (4:3) = "3840x2880 (8x)"
Render Scale = 8
; "Use Game Setting", "Fullscreen", "Borderless", "Windowed"
Window Mode = "Use Game Setting"
; "4x" or "Off"
MSAA = "4x"
Anisotropic Filtering = true
GPU Local Textures = true
; The two exclusive-fullscreen fixes (both builds read these): the display's current refresh rate
; instead of the game's 60/1 request, and the selected Screen Resolution instead of the monitor's
; largest mode. Off restores the game's own behaviour for comparison runs.
Fullscreen Refresh Rate Fix = true
Fullscreen Resolution Fix = true

; ---- research keys (the Lab build only) ----
; Draw census: F11 logs the next N frames (every draw: target, shaders, textures, constants,
; callers, vertex uploads). 2 is enough for a still frame; 12 spans a menu animation. A census
; frame is several megabytes of log. Draw Census At (s) logs one automatically N seconds after
; start (0 = only on F11 or command).
Draw Census Frames = 2
Draw Census At (s) = 0
; Live commands: the plugin polls logs\MGSPWEnabler_live.txt four times a second and runs each
; line ("census 12", "tbias ...", "bias ..."), then empties the file. F11 needs this on.
Live Commands = true
; GPU timing: after each census, timestamp queries around every pass for this many frames and
; a "PW timing:" table in the log (milliseconds per pass, frame rate over the window).
Time Passes = true
Time Frames = 60
; Every shader's bytecode to logs\shaders\<hash>.<kind>.cso, for disassembly.
Dump Shaders = false
; Light Hooks: only the resolve is hooked (no per-draw hooks): the frame rate of a Release-like
; build with the settings still applied. No census or timing while on.
Light Hooks = false
; Pacing Log: the frame pacing instrumentation (import hooks on the game's Sleep and wait calls, a
; tick counter, a 5 s summary in the log). The Sleep hook runs on every one of the render thread's
; ~170,000 Sleep(0) calls a frame: keep it off for runs you judge by eye.
Pacing Log = false
; Hitch Sampler: after 20 ms of the render thread waiting for a frame, every other thread is
; sampled once (module+offset, game return addresses, current wait): "PW sampler:" in the log.
Hitch Sampler = false
; VBlank Wait Timeout (ms): 0 the game's infinite wait on its vblank event (two threads reset one
; event; a wakeup lost in that race costs a whole frame); 1 bounds the loss to a millisecond.
VBlank Wait Timeout = 0
; Frame Handoff Wait (ms): the game drops a finished frame when the render thread still holds
; the previous one (a vsync-blocked Present) and the display repeats a frame; N waits up to
; N ms for the render thread instead. 0 the game's.
Frame Handoff Wait = 0
; VBlank Wait Log: the game thread's vblank waits (ticks passed, work time between waits); every
; skipped tick logged, a 5 s summary per thread.
VBlank Wait Log = false
; Frame Skip Governor: true the game's own (a frame that measures long raises the vblank wait
; count: a doubled frame, about once a second in direct-flip modes at 60 Hz); false prevents it.
Frame Skip Governor = true
; Frame Pacing: "Game" (the game's own 60.000 Hz ticker), "Display" (the ticker paced to the
; display's real refresh rate) or "VBlank" (the ticker waits for the display's vertical blank, one
; per tick at 60 Hz, two at 120 Hz: the game thread and the display never drift apart in phase,
; which is what doubles a frame every second or so on a 60 Hz desktop).
Frame Pacing = "Game"
; Present Sync: -1 leaves the game's sync interval (1, a vsync wait in Present); 0 presents
; without waiting (borderless stays tear-free through the compositor; exclusive fullscreen tears).
Present Sync = -1
; Allow Tearing: the flip chain is created tearing-capable and windowed Presents never wait for
; the display (sync 0 + ALLOW_TEARING). Borderless stays whole through the compositor; the
; game's render thread is never held on vsync, so the game thread never misses a tick.
Allow Tearing = false
; Present Without Blocking: Present is asked not to block and retried until it goes through, so
; the Direct3D device lock is not held across the driver's vsync wait and the game thread can
; keep recording. Same pacing, no tearing.
Present Without Blocking = false
; Waitable Swap Chain: the chain is rebuilt with a frame-latency waitable object and the frame is
; paced on that handle, so the vsync wait happens outside Present and the Direct3D device lock is
; not held across it. This is the candidate fix for the 60 Hz stutter.
Waitable Swap Chain = false
; State Object Cache: the game asks the device for the same handful of sampler and depth-stencil
; states hundreds of times a frame, and every call takes the Direct3D device lock that the render
; thread holds inside Present. Serving them from a cache keeps the game thread off that lock.
State Object Cache = false

; Mouse. The game already reads the mouse through Raw Input and turns the camera in proportion to
; your hand; these correct what is wrong on the way.
; Mouse Late Sample: the game reads the mouse, then waits out the frame, then turns the camera,
; so the camera always moves by what your hand did a frame ago. true reads the mouse again right
; before the camera uses it (nothing is counted twice): about 15 ms less latency.
Mouse Late Sample = true
; Mouse Prompt Pump: the game's mouse thread handles one message and then sleeps, every pass, so
; fast movement arrives in clumps and the turn speed wobbles, most of all with a high polling rate
; mouse. true handles each message as it arrives. Needs Busy Wait Fix = Everything.
Mouse Prompt Pump = true
; Mouse Fraction Carry: each frame the game cuts the turn down to a whole angle unit and throws the
; fraction away (up to 8% of a slow movement at low sensitivity). true keeps the fraction.
Mouse Fraction Carry = true
; Mouse Uniform Rail: in the normal third-person camera, looking up and down slides the camera
; along a rail of four presets, so the same hand movement tilts the view by very different amounts
; depending on where the camera is. true makes one count tilt the view as much as it turns it
; sideways, everywhere. Off by default: it changes the feel. Aiming is not affected.
Mouse Uniform Rail = false
; Mouse Vertical Ratio: with Mouse Uniform Rail, vertical speed as a multiple of horizontal (0.1 to 4).
Mouse Vertical Ratio = 1.0

; Input Probe (Lab): one line per frame with mouse activity (counts, latch, look value, camera turn,
; rail position), and live switches with a beep (high = on): F5 uniform rail, F6 fraction carry,
; F7 late sample, F8 prompt pump, F9 those three together, F10 logs the mouse thread's histograms.
Input Probe = false
; Swap Chain Buffers: 0 the game's (2), else the flip chain's buffer count.
Swap Chain Buffers = 0
; One-off log lines at start-up.
Log Loaded Modules = false
Log Decrypt Timing = false
Log Command Line = false
; Experiments (0 = off): the post chain's target size when it should differ from the scene;
; the swap chain's buffers at the internal size; a fractional render scale (breaks effects,
; kept as the record of why); the full-canvas scene targets forced to a size.
Internal Size Width = 0
Internal Size Height = 0
Back Buffer At Internal Size = false
Render Scale Hundredths = 0
Scene Size Width = 0
Scene Size Height = 0

[Debugging]
; On for every Lab run: every setting prints what it resolved to, and every hook says whether
; it was installed.
Debug Logging = true
